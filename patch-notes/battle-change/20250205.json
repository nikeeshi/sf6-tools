  "common": [
    {
      "title": "キャラクターガイド・チュートリアル",
      "body": [
        {
          "category": "不具合修正",
          "text": "バトル調整の影響で発生していたキャラクターガイド・チュートリアルのリプレイの不備や、説明文とゲーム中の内容に齟齬が発生していた箇所等を修正しました。"
        }
      ]
    },
    {
      "title": "ドライブインパクト",
      "body": [
        {
          "category": "不具合修正",
          "text": "アーマーで攻撃を受け止めた後、相手に攻撃がヒットしなかった際の先行入力受付時間が通常時よりも短くなっていた不具合を修正しました。"
        }
      ]
    },
    {
      "title": "ドライブリバーサル(ガード/起き上がり)",
      "body": [
        {
          "category": "不具合修正",
          "text": "動作1F目に設定されていた前方への移動値を、他のキャラクターに合わせる形で削除しました。<br><br>対応キャラクター：キンバリー・ブランカ"
        }
      ]
    },
    {
      "title": "ジャストパリィ",
      "body": [
        {
          "category": "調整",
          "text": "多段技をジャストパリィされた際、2段目以降をキャンセルできないようにする調整を改めて実装しました。<br><br><span class='battle_change_caution'>2024.12.02で実装した本調整は、不具合により巻き戻ししておりましたが、不具合を解消し本アップデートで再度適用いたしました。</span>"
        }
      ]
    }
  ],
