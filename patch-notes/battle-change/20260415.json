  "policy": [],
  "common": [
    {
      "title": "ドライブパリィ",
      "body": [
        {
          "category": "不具合修正",
          "text": "攻撃を受け止めてガードストップが解けた後、ドライブラッシュを発動できないタイミングがあった現象を修正しました。"
        }
      ]
    },
    {
      "title": "起き上がり時にドライブラッシュが重なった際の先行入力について",
      "body": [
        {
          "category": "調整・不具合修正",
          "text": "前回のアップデートで行った「起き上がり時の先行入力受付時間を3F増加」という調整の結果、<br>起き上がり時に特定のフレームで相手のドライブラッシュが重なった際に、先行入力が有効となるタイミングが想定以上に早くなっていました。<br><br>本現象への対応として、起き上がり時にドライブラッシュが重なった際の先行入力受付時間を3F削減することで、<br>先行入力が有効となるタイミングをアレックスリリース前と同様にしました。"
        }
      ]
    },
    {
      "title": "モダン操作での特定の空中行動について",
      "body": [
        {
          "category": "不具合修正",
          "text": "モダン操作にて、ジャンプ攻撃に派生できる一部の空中行動中<br>（ダルシムのヨガフロート、ラシードのウイング・ストロークなど）に相手がドライブラッシュを発動した際に、<br>暗転中にAUTO+攻撃でジャンプ攻撃（アシスト）を出そうとすると、一定時間攻撃が出せなくなってしまう不具合を修正しました。"
        }
      ]
    }
  ],
  "fighter": [
